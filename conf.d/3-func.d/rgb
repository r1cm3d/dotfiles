cc() {
        local COLOR=${1:-00FF00}
        local args=()
        local device
        for device in 0 1 2 5 6; do
                args+=(-d "$device" -m direct -c "$COLOR")
        done
        openrgb --client 127.0.0.1:6742 "${args[@]}" >/dev/null
        sleep 1
        liquidctl --match H100i set led color fixed "$COLOR" >/dev/null
}
